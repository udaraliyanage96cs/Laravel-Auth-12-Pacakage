{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "udara/laravel-auth",
    "description": "A reusable, modular Authentication, User Management, and Role-based Administration package for Laravel 12.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "authentication",
        "auth",
        "user-management",
        "roles",
        "permissions",
        "otp",
        "google-login",
        "admin-panel"
    ],
    "authors": [
        {
            "name": "Udara Liyanage",
            "email": "ldudaraliyanage@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0",
        "laravel/socialite": "^5.0",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Udara\\LaravelAuth\\": "src/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Udara\\LaravelAuth\\LaravelAuthServiceProvider"
            ]
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
